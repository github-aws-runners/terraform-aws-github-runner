{
  "name": "Runner - repo registration token",
  "request": {
    "method": "POST",
    "urlPathPattern": "(?:/api/v3)?/repos/[^/]+/[^/]+/actions/runners/registration-token"
  },
  "response": {
    "status": 201,
    "jsonBody": {
      "token": "runner-registration-token-mock",
      "expires_at": "2099-01-01T00:00:00Z"
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
