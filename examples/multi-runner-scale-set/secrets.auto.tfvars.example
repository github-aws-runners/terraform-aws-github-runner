# Copy this file to secrets.auto.tfvars and replace every placeholder.
# secrets.auto.tfvars is ignored by Git.

environment = "github-runners-demo"
aws_region  = "eu-west-1"

github_app = {
  id              = "123456"
  installation_id = "12345678"
  key_base64      = "REPLACE_WITH_BASE64_ENCODED_PRIVATE_KEY"
}

github = {
  runner_owner       = "example-org"
  registration_level = "organization"
}

scale_set = {
  name              = "linux-scale-set"
  runner_group_name = "Default"
  min_runners       = 0
  container = {
    image = "ghcr.io/github-aws-runners/terraform-aws-github-runner-scale-set-service@sha256:REPLACE_WITH_RELEASE_DIGEST"
  }
}
