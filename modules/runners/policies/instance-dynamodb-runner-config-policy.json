{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem"
      ],
      "Resource": "${table_arn}",
      "Condition": {
        "ForAllValues:StringLike": {
          "dynamodb:LeadingKeys": [
            "${config_key_prefix}*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:DeleteItem",
        "dynamodb:GetItem"
      ],
      "Resource": "${table_arn}",
      "Condition": {
        "ForAllValues:StringLike": {
          "dynamodb:LeadingKeys": ${token_leading_keys_json}
        }
      }
    }%{ if kms_key_arn != "" ~},
    {
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:Encrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "${kms_key_arn}"
    }
%{ endif ~}
  ]
}
