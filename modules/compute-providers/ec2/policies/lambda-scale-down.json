{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["ec2:DescribeInstances", "ec2:DescribeTags"],
      "Resource": ["*"]
    },
    {
      "Effect": "Allow",
      "Action": ["ec2:TerminateInstances", "ec2:CreateTags", "ec2:DeleteTags"],
      "Resource": ["*"],
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/ghr:Application": "github-action-runner"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": ["ec2:TerminateInstances", "ec2:CreateTags", "ec2:DeleteTags"],
      "Resource": ["*"],
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/gh:environment": "${environment}"
        }
      }
    }
  ]
}
