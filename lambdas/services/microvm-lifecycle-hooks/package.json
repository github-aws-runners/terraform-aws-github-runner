{
  "name": "@aws-github-runner/microvm-lifecycle-hooks",
  "version": "1.0.0",
  "private": true,
  "description": "AWS Lambda MicroVM lifecycle hook server for ephemeral GitHub Actions runners",
  "main": "src/public.ts",
  "exports": {
    ".": "./src/public.ts"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node dist/server.js",
    "test": "NODE_ENV=test nx test",
    "test:watch": "NODE_ENV=test nx test --watch",
    "lint": "eslint src",
    "build": "node build.mjs",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format-check": "prettier --check \"**/*.{ts,json,md}\"",
    "all": "yarn build && yarn format && yarn lint && yarn test"
  },
  "devDependencies": {
    "@types/node": "^22.19.3",
    "esbuild": "^0.27.0"
  },
  "dependencies": {
    "@aws-github-runner/storage-providers": "*"
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "default",
          "^default"
        ],
        "outputs": [
          "{projectRoot}/dist/**/*"
        ]
      }
    },
    "includedScripts": [
      "build",
      "format",
      "format-check",
      "lint",
      "start",
      "all"
    ]
  }
}
